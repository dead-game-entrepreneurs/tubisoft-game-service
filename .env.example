# Documentation-only addresses; replace before starting a beta deployment.
TUBISOFT_ADVERTISE_IP=192.0.2.10
# Open beta: anyone can create an account and connect. Optionally narrow this
# comma-separated IPv4 CIDR setting for a private installation.
TUBISOFT_ALLOWED_CIDRS=0.0.0.0/0
TUBISOFT_BIND_IP=0.0.0.0
# Default production profile. GR2 and R6 are opt-in development profiles; see
# docs/multi-game-architecture.md and deploy/compose.gr2.yaml. Rainbow Six 3
# needs no overlay: set TUBISOFT_GAMES=xiii,r6 (its ports 30020-30022 are
# always published by compose.yaml and answer only when r6 is enabled).
# Brothers in Arms (bia, ports 30030-30032) is enabled the same way.
# 187 Ride or Die (rod) has experimental matchmaking with retail room joins;
# opt in with TUBISOFT_GAMES=xiii,rod (compose.yaml publishes ports 30040-30042).
# Brothers in Arms (bia, ports 30030-30032) and Earned in Blood (eib, ports
# 30050-30052, plus TCP 30053 for its chat server) are enabled the same way.
TUBISOFT_GAMES=xiii
TUBISOFT_ROUTER_PORT=30000
TUBISOFT_LAUNCHER_PORT=30001
TUBISOFT_NAT_PORT=30002
# Default: let the existing reverse proxy own public TCP 80.
TUBISOFT_HTTP_BIND=127.0.0.1
TUBISOFT_HTTP_PUBLISH_PORT=18080
# Off by default. Only for test setups where a game client runs on the Docker
# host itself: such a client arrives from the bridge gateway, and "auto"
# reports it at TUBISOFT_ADVERTISE_IP inside a container (or set the gateway
# IPv4 explicitly). Leave it off on a deployed server: where Docker's
# userland proxy forwards remote traffic, remote players also arrive from the
# gateway and would all be misreported.
# TUBISOFT_HOST_ALIAS=auto

# Optional private result ingestion; disabled until both are configured in the
# service process. See docs/shared-ladder.md for container-loopback requirements.
# TUBISOFT_RESULTS_PORT=8081
# TUBISOFT_RESULTS_KEYRING=/state/private-worker-grants.json
# Experimental populated native ranking replies; default remains empty success.
# TUBISOFT_NATIVE_RANKINGS=0

# Rainbow Six 3 "Latest News" items (when r6 is enabled). Unset keeps
# the built-in text; printable ASCII, up to 512 characters each.
# TUBISOFT_R6_NEWS_1=
# TUBISOFT_R6_NEWS_2=

# Brothers in Arms MOTD lines (when bia is enabled), same rules as above.
# TUBISOFT_BIA_NEWS_1=
# TUBISOFT_BIA_NEWS_2=

# 187 Ride or Die News text (when rod is enabled), same rules as above.
# TUBISOFT_ROD_NEWS_1=
# TUBISOFT_ROD_NEWS_2=

# Optional forced two-player 187 relay; requires deploy/compose.rod-relay.yaml.
# UDP pool ports must reach this service and must not overlap other listeners.
# This is forced routing for validation, not automatic direct-to-relay fallback.
# TUBISOFT_ROD_RELAY_MODE=relay
# TUBISOFT_ROD_RELAY_ADVERTISE_IP=192.0.2.10
# TUBISOFT_ROD_RELAY_BIND_IP=0.0.0.0
# TUBISOFT_ROD_RELAY_FIRST_PORT=30400
# TUBISOFT_ROD_RELAY_LAST_PORT=30431

# Brothers in Arms: Earned in Blood MOTD lines (when eib is enabled).
# TUBISOFT_EIB_NEWS_1=
# TUBISOFT_EIB_NEWS_2=
