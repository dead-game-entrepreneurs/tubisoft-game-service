# Documentation-only addresses; replace before starting a beta deployment.
TUBISOFT_ADVERTISE_IP=192.0.2.10
# Open beta: anyone can create an account and connect. Optionally narrow this
# comma-separated IPv4 CIDR setting for a private installation.
TUBISOFT_ALLOWED_CIDRS=0.0.0.0/0
TUBISOFT_BIND_IP=0.0.0.0
# Default production profile. GR2 and R6 are opt-in development profiles; see
# docs/multi-game-architecture.md, deploy/compose.gr2.yaml and deploy/compose.r6.yaml.
TUBISOFT_GAMES=xiii
TUBISOFT_ROUTER_PORT=30000
TUBISOFT_LAUNCHER_PORT=30001
TUBISOFT_NAT_PORT=30002
# Default: let the existing reverse proxy own public TCP 80.
TUBISOFT_HTTP_BIND=127.0.0.1
TUBISOFT_HTTP_PUBLISH_PORT=18080
# Clients on the Docker host itself arrive from the bridge gateway. "auto"
# (default) reports them at TUBISOFT_ADVERTISE_IP inside a container; "off"
# disables this, or set the gateway IPv4 explicitly.
# TUBISOFT_HOST_ALIAS=auto

# Optional private result ingestion; disabled until both are configured in the
# service process. See docs/shared-ladder.md for container-loopback requirements.
# TUBISOFT_RESULTS_PORT=8081
# TUBISOFT_RESULTS_KEYRING=/state/private-worker-grants.json
# Experimental populated native ranking replies; default remains empty success.
# TUBISOFT_NATIVE_RANKINGS=0

# Rainbow Six 3 "Latest News" items (with deploy/compose.r6.yaml). Unset keeps
# the built-in text; printable ASCII, up to 512 characters each.
# TUBISOFT_R6_NEWS_1=
# TUBISOFT_R6_NEWS_2=
